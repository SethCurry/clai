;; Example clai configuration.
;;
;; Copy this to one of:
;;   - the path in $CLAI_CONFIG
;;   - ./clai.edn            (next to where you launch clai)
;;   - ~/.config/clai/config.edn
;;
;; The first file that exists wins. Any key omitted here falls back to the
;; environment (OLLAMA_HOST, OLLAMA_API_KEY, CLAI_MODEL, ...) and the
;; built-in defaults, so you only need to set what you want to change.

{:model          "gemma3"
 ;; Optional system prompt prepended to every session's history. The contents
 ;; of an AGENTS.md in a new session's working directory are appended to it.
 :system-prompt  "You are a concise, helpful coding agent."

 ;; Max consecutive tool-call rounds before the agent gives up.
 :max-tool-rounds 8

 ;; Forwarded verbatim to Ollama's /api/chat as request keys.
 :options        {:temperature 0.7}
 :think          false
 ;; :format       "json"      ; force JSON output when set

 ;; Ollama server connection. Any subset of :host/:api-key/:timeout may be
 ;; given; omitted keys fall back to OLLAMA_HOST / OLLAMA_API_KEY / defaults.
 :ollama         {:host     "http://localhost:11434"
                  :api-key  "sk-..."
                  :timeout  600000}           ; milliseconds

 ;; PostgreSQL storage for agent sessions and their event logs. Omitted keys
 ;; fall back to CLAI_POSTGRES_* / PG* environment variables and then to the
 ;; local development database (localhost:5432/clai as clai/secret, matching
 ;; docker-compose.yml). :url may be used instead of :host/:port/:database for
 ;; a full JDBC URL; its credentials replace the user/password defaults. The
 ;; agent connects lazily and applies schema/schema.sql on the first session
 ;; operation; call clai.daemon.postgres/ensure-schema! to fail fast at startup
 ;; instead.
 :postgres       {:host     "localhost"
                  :port     5432
                  :database "clai"
                  :user     "clai"
                  :password "secret"
                  :ssl-mode "prefer"       ; disable/allow/prefer/require/...
                  :connect-timeout 10      ; seconds
                  :socket-timeout  30}

 ;; OpenProject work-package tools. Uncomment and configure to let the agent
 ;; list projects, list tasks, create tasks, update tasks, and read, add, and
 ;; edit task comments. :url may be the
 ;; instance root or its /api/v3 API root. Authenticate with :api-key (an
 ;; OpenProject API token) or :username/:password. Omitted keys fall back to
 ;; OPENPROJECT_URL / OPENPROJECT_API_KEY / OPENPROJECT_USERNAME /
 ;; OPENPROJECT_PASSWORD / OPENPROJECT_PROJECT / OPENPROJECT_TYPE /
 ;; OPENPROJECT_TIMEOUT.
 ;; :openproject {:url     "https://openproject.example.com"
 ;;               :api-key "opapi-..."
 ;;               :project "my-project" ; default project for new tasks
 ;;               :type    "Task"}      ; default type for new tasks

 ;; Which built-in tools to expose to the model, in this order. Unknown ids
 ;; are skipped. Omit the key entirely to enable every built-in tool; set it
 ;; to [] to disable tools entirely.
 :tools          ["read_file"
                  "write_file"
                  "list_directory"
                  "run_command"
                  "eval_clojure"
                  "spawn_agent"
                  ;; OpenProject tools (configure :openproject above first):
                  ;; "openproject_list_projects"
                  ;; "openproject_list_work_packages"
                  ;; "openproject_create_work_package"
                  ;; "openproject_update_work_package"
                  ;; "openproject_list_comments"
                  ;; "openproject_add_comment"
                  ;; "openproject_update_comment"
                  ]

 ;; Which installed plugins are active for the agent's sessions. Plugin names
 ;; (or database ids) are accepted. Omit the key to run every enabled plugin;
 ;; set it to [] to disable plugins. A session's agent configuration can
 ;; override this list.
 ;; :plugins     ["todays-date"]
 }